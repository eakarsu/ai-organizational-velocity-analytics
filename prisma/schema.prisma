// Generated schema — modeled after beautyhqio conventions.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  active       Boolean @default(true)
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  role         Role     @default(ANALYST)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

enum Role {
  ADMIN
  MANAGER
  ANALYST
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  actorName String?
  action    String
  entity    String
  entityId  String?
  detail    String?
  createdAt DateTime @default(now())
}

model Team {
  id        String   @id @default(cuid())
  name String
  department String
  lead String
  headcount Int
  aiSpendMonthly Float
  status String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deliveryCycles DeliveryCycle[]
  workItems WorkItem[]
  reworkEvents ReworkEvent[]
  approvalDelays ApprovalDelay[]
  coordinationCosts CoordinationCost[]
  qualitySignals QualitySignal[]
  aiUsageRecords AiUsageRecord[]
  productivityBaselines ProductivityBaseline[]
  experiments Experiment[]
  benchmarkSnapshots BenchmarkSnapshot[]
  executiveReports ExecutiveReport[]
}

model DeliveryCycle {
  id        String   @id @default(cuid())
  name String
  period String
  itemsCompleted Int
  avgCycleDays Float
  medianCycleDays Float
  status String
  teamId String?
  team Team? @relation(fields: [teamId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model WorkItem {
  id        String   @id @default(cuid())
  key String
  title String
  kind String
  status String
  cycleHours Float
  reopenCount Int
  teamId String?
  team Team? @relation(fields: [teamId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ReworkEvent {
  id        String   @id @default(cuid())
  workItemRef String
  cause String
  addedHours Float
  origin String
  occurredAt DateTime?
  status String
  teamId String?
  team Team? @relation(fields: [teamId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ApprovalDelay {
  id        String   @id @default(cuid())
  gate String
  approver String
  delayHours Float
  workItemRef String
  status String
  resolvedAt DateTime?
  teamId String?
  team Team? @relation(fields: [teamId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CoordinationCost {
  id        String   @id @default(cuid())
  activity String
  participants String
  hoursPerWeek Float
  weeklyCost Float
  category String
  status String
  teamId String?
  team Team? @relation(fields: [teamId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model QualitySignal {
  id        String   @id @default(cuid())
  kind String
  metric String
  value Float
  target Float
  trend String
  status String
  teamId String?
  team Team? @relation(fields: [teamId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AiUsageRecord {
  id        String   @id @default(cuid())
  tool String
  userRef String
  tokens Float
  cost Float
  taskType String
  usedAt DateTime?
  teamId String?
  team Team? @relation(fields: [teamId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ProductivityBaseline {
  id        String   @id @default(cuid())
  metric String
  period String
  baselineValue Float
  currentValue Float
  deltaPct Float
  status String
  teamId String?
  team Team? @relation(fields: [teamId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Experiment {
  id        String   @id @default(cuid())
  hypothesis String
  change String
  successMetric String
  status String
  startedAt DateTime?
  result String?
  teamId String?
  team Team? @relation(fields: [teamId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model BenchmarkSnapshot {
  id        String   @id @default(cuid())
  period String
  metric String
  teamValue Float
  orgP50 Float
  orgP90 Float
  status String
  teamId String?
  team Team? @relation(fields: [teamId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ExecutiveReport {
  id        String   @id @default(cuid())
  period String
  generatedFor String
  headline String
  body String
  status String
  publishedAt DateTime?
  teamId String?
  team Team? @relation(fields: [teamId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}


model WorkflowAnalysis {
 id String @id @default(cuid())
 actorId String
 workflow String
 subjectEntity String
 subjectId String
 input Json
 evidence Json
 evidenceHash String
 result Json
 model String
 receipt String?
 createdAt DateTime @default(now())
 @@index([workflow, createdAt])
}
model RecordReview {
 id String @id @default(cuid())
 actorId String
 entity String
 entityId String
 version String
 reason String
 createdAt DateTime @default(now())
 @@unique([entity, entityId, version, actorId])
}
model UsageBucket {
 id String @id
 calls Int
}
model IssuedCredential {
 token String @id
 entity String
 entityId String
 version String
 assertion Json
 createdAt DateTime @default(now())
 revokedAt DateTime?
 @@index([entity, entityId, createdAt])
}

model DomainArtifact {
 id String @id @default(cuid())
 subjectEntity String
 subjectId String
 title String
 content String
 contentHash String
 actorId String
 approvedBy String?
 createdAt DateTime @default(now())
 @@index([subjectEntity, subjectId])
}

model RecordApproval {
 id String @id
 version String
}
model DomainExecution {
 id String @id
 actorId String
 connectorId String
 action String
 subjectEntity String
 subjectId String
 version String
 status String
 result Json?
 createdAt DateTime @default(now())
}

model WorkSession {
 id String @id @default(cuid())
 actorId String
 respondentId String
 subjectEntity String
 subjectId String
 questions Json
 answers Json
 currentQuestion String?
 status String
 deadline DateTime
 createdAt DateTime @default(now())
 @@index([respondentId, createdAt])
}
model SessionMedia {
 id String @id @default(cuid())
 sessionId String
 questionId String
 actorId String
 contentType String
 bytes Bytes
 contentHash String
 createdAt DateTime @default(now())
 @@index([sessionId])
}
